{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SalesTurn",
  "description": "Structured output schema for sales agent responses",
  "type": "object",
  "properties": {
    "voice_instructions": {
      "type": "string",
      "description": "TTS directives for persuasive delivery"
    },
    "system_response": {
      "type": "string",
      "description": "The spoken response to the prospect"
    },
    "sales_stage": {
      "type": "string",
      "enum": [
        "discovery",
        "needs_analysis",
        "presentation",
        "objection_handling",
        "closing"
      ],
      "description": "Current stage in the sales process"
    },
    "customer_intent": {
      "type": "string",
      "enum": [
        "exploring",
        "interested",
        "objection",
        "ready_to_buy",
        "not_interested"
      ],
      "description": "Prospect's buying intent"
    },
    "pain_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identified customer pain points"
    },
    "qualification_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Lead qualification score (0-100)"
    },
    "objections_raised": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer objections raised"
    },
    "next_action": {
      "type": "string",
      "description": "Recommended next step in sales process"
    },
    "product_features_mentioned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product features discussed"
    }
  },
  "required": ["system_response"],
  "additionalProperties": false
}
